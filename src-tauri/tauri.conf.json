{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iso Piping 3D",
  "mainBinaryName": "IsoPiping3D",
  "version": "0.1.0",
  "identifier": "io.github.nicostaud.isopiping3d",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Iso Piping 3D",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Isometric piping sketch, 3D model and MTO",
    "longDescription": "Isometric piping sketch on an iso grid, 3D model generation and bill of materials (MTO) for onshore and offshore Oil & Gas piping. Works offline.",
    "fileAssociations": [
      {
        "ext": ["isop"],
        "name": "Iso Piping project",
        "description": "Iso Piping 3D project",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "nsis": { "installMode": "currentUser" }
    }
  }
}
